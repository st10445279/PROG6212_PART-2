@model CMCSdemo.Models.Claim
@{
    ViewData["Title"] = "Claim Status";
}

<div class="status-container">
    <div class="status-header">
        <h1>Claim #@Model.ClaimId Status</h1>
        <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status.ToString().Replace("SubmittedTo", "With ").Replace("By", " ")</span>
    </div>

    <div class="progress-tracker">
        <div class="progress-step @(Model.Status >= CMCSdemo.Models.ClaimStatus.Pending ? "completed" : "")">
            <div class="step-circle">1</div>
            <div class="step-label">Submitted</div>
            <div class="step-date">@Model.SubmittedDate.ToString("dd MMM yyyy")</div>
        </div>

        <div class="progress-line @(Model.Status >= CMCSdemo.Models.ClaimStatus.VerifiedByCoordinator ? "completed" : "")"></div>

        <div class="progress-step @(Model.Status >= CMCSdemo.Models.ClaimStatus.VerifiedByCoordinator ? "completed" : "")">
            <div class="step-circle">2</div>
            <div class="step-label">Verified</div>
            <div class="step-date">@(Model.VerifiedDate?.ToString("dd MMM yyyy") ?? "Pending")</div>
        </div>

        <div class="progress-line @(Model.Status >= CMCSdemo.Models.ClaimStatus.ApprovedByManager ? "completed" : "")"></div>

        <div class="progress-step @(Model.Status >= CMCSdemo.Models.ClaimStatus.ApprovedByManager ? "completed" : "")">
            <div class="step-circle">3</div>
            <div class="step-label">Approved</div>
            <div class="step-date">@(Model.ApprovedDate?.ToString("dd MMM yyyy") ?? "Pending")</div>
        </div>
    </div>

    <div class="claim-details-grid">
        <div class="detail-card">
            <h3>Claim Information</h3>
            <div class="detail-row">
                <span class="detail-label">Lecturer:</span>
                <span class="detail-value">@Model.LecturerName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Hours Worked:</span>
                <span class="detail-value">@Model.HoursWorked hrs</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Hourly Rate:</span>
                <span class="detail-value">R @Model.HourlyRate</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Total Amount:</span>
                <span class="detail-value total-amount">R @Model.TotalAmount.ToString("N2")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
            {
                <div class="detail-row">
                    <span class="detail-label">Notes:</span>
                    <span class="detail-value">@Model.AdditionalNotes</span>
                </div>
            }
        </div>

        @if (Model.Documents.Any())
        {
            <div class="detail-card">
                <h3>Supporting Documents</h3>
                @foreach (var doc in Model.Documents)
                {
                    <div class="document-item">
                        <span class="doc-icon">📄</span>
                        <span class="doc-name">@doc.FileName</span>
                        <span class="doc-size">(@(doc.FileSize / 1024) KB)</span>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.CoordinatorComments))
        {
            <div class="detail-card">
                <h3>Coordinator Comments</h3>
                <p>@Model.CoordinatorComments</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ManagerComments))
        {
            <div class="detail-card">
                <h3>Manager Comments</h3>
                <p>@Model.ManagerComments</p>
            </div>
        }
    </div>

    <div class="form-actions">
        <a asp-action="Dashboard" class="btn btn-primary">Back to Dashboard</a>
    </div>
</div>